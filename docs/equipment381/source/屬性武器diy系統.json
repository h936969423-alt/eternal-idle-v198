  "schema": "CREATE TABLE `屬性武器diy系統` (\n  `id` int(3) unsigned NOT NULL DEFAULT '0' COMMENT '索引碼',\n  `name` varchar(10) DEFAULT NULL,\n  `stage` int(2) NOT NULL DEFAULT '0',\n  `chance` int(5) NOT NULL DEFAULT '0',\n  `probability` int(5) NOT NULL DEFAULT '0',\n  `type_bind` double(5,1) NOT NULL DEFAULT '0.0',\n  `type_drain_hp` double(5,1) NOT NULL DEFAULT '0.0',\n  `type_drain_mp` int(5) NOT NULL DEFAULT '0',\n  `type_dmgup` double(2,1) NOT NULL DEFAULT '0.0',\n  `type_range` int(2) NOT NULL DEFAULT '0',\n  `type_range_dmg` int(2) NOT NULL DEFAULT '0',\n  `type_light_dmg` int(2) NOT NULL DEFAULT '0',\n  `type_skill_1` int(1) NOT NULL DEFAULT '0',\n  `type_skill_2` int(1) NOT NULL DEFAULT '0',\n  `type_skill_3` int(1) NOT NULL DEFAULT '0',\n  `type_skill_time` double(5,1) NOT NULL DEFAULT '0.0',\n  `type_poly_list` varchar(50) NOT NULL,\n  `type_remove_weapon` int(1) NOT NULL DEFAULT '0',\n  `type_remove_doll` int(1) NOT NULL DEFAULT '0',\n  `type_remove_armor` int(5) NOT NULL DEFAULT '0',\n  `最小吸血量` int(5) NOT NULL DEFAULT '0',\n  `最大吸血量` int(5) NOT NULL,\n  `額外近距離傷害` int(10) NOT NULL DEFAULT '0',\n  `額外遠距離傷害` int(10) NOT NULL DEFAULT '0',\n  PRIMARY KEY (`id`,`stage`)\n) ENGINE=MyISAM DEFAULT CHARSET=utf8 COMMENT='MyISAM free: 10240 kB';",
