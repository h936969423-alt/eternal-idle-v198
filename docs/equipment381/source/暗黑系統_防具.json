  "schema": "CREATE TABLE `暗黑系統_防具` (\n  `流水號` int(10) NOT NULL DEFAULT '0' COMMENT '此DB負責控制附著在防具上暗黑系統屬性，鍵入值皆為最大值，系統會自行從１到最大值中抽出一個數．',\n  `血量` int(10) NOT NULL DEFAULT '0' COMMENT '增加血量',\n  `魔力` int(10) NOT NULL DEFAULT '0' COMMENT '增加魔量',\n  `回血` int(10) NOT NULL DEFAULT '0',\n  `回魔` int(10) NOT NULL DEFAULT '0',\n  `防禦` int(10) NOT NULL DEFAULT '0',\n  `魔法防禦` int(10) NOT NULL DEFAULT '0',\n  `物理傷害減免` int(10) NOT NULL DEFAULT '0',\n  `弓傷害減免` int(10) NOT NULL DEFAULT '0',\n  `魔法傷害減免` int(10) NOT NULL DEFAULT '0',\n  `pvp傷害減免` int(10) NOT NULL DEFAULT '0',\n  `boss傷害減免` int(10) NOT NULL DEFAULT '0',\n  `技能施放機率` int(10) NOT NULL DEFAULT '0',\n  `特效` int(10) NOT NULL DEFAULT '0',\n  `屬性名稱` varchar(255) DEFAULT NULL,\n  `屬性說明` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`流水號`)\n) ENGINE=MyISAM DEFAULT CHARSET=utf8 COMMENT='MyISAM free: 10240 kB;",
