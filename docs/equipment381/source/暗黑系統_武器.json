  "schema": "CREATE TABLE `暗黑系統_武器` (\n  `流水號` int(10) NOT NULL DEFAULT '0' COMMENT '此DB負責控制附著在防具上暗黑系統屬性，鍵入值皆為最大值，系統會自行從１到最大值中抽出一個數．技能方面如需增加，需要從核心另外設定判斷，如果直接設定可能會當機',\n  `物理命中` int(10) NOT NULL DEFAULT '0',\n  `弓命中` int(10) NOT NULL DEFAULT '0',\n  `魔法命中` int(10) NOT NULL DEFAULT '0',\n  `魔攻` int(10) NOT NULL DEFAULT '0',\n  `爆擊傷害提升` int(10) NOT NULL DEFAULT '0',\n  `爆擊機率` int(10) NOT NULL DEFAULT '0',\n  `物理傷害` int(10) NOT NULL DEFAULT '0',\n  `弓傷害` int(10) NOT NULL DEFAULT '0',\n  `魔法傷害` int(10) NOT NULL DEFAULT '0',\n  `pvp傷害提升` int(10) NOT NULL DEFAULT '0',\n  `boss傷害提升` int(10) NOT NULL DEFAULT '0',\n  `技能施放機率` int(10) NOT NULL DEFAULT '0',\n  `特效` int(10) NOT NULL DEFAULT '0',\n  `屬性名稱` varchar(255) DEFAULT NULL,\n  `屬性說明` varchar(255) DEFAULT NULL,\n  PRIMARY KEY (`流水號`)\n) ENGINE=MyISAM DEFAULT CHARSET=utf8 COMMENT='MyISAM free: 10240 kB;",
