  "schema": "CREATE TABLE `weapon_skill_power` (\n  `id` int(10) NOT NULL AUTO_INCREMENT COMMENT '序號',\n  `classname` varchar(45) NOT NULL DEFAULT '0',\n  `level` int(10) NOT NULL DEFAULT '100' COMMENT '發動等級百分比',\n  `type1` int(10) NOT NULL DEFAULT '0',\n  `type2` int(10) unsigned NOT NULL DEFAULT '0',\n  `type3` int(10) NOT NULL DEFAULT '0',\n  `attr` int(10) NOT NULL DEFAULT '0' COMMENT '具備攻擊屬性 0:無属性 1:地 2:火 4:水 8:風',\n  `ac_mr` int(10) NOT NULL DEFAULT '0' COMMENT '受到抗魔或是防禦力影響 0:無視 1:防禦 2:抗魔',\n  `gfxid1` int(10) NOT NULL DEFAULT '0' COMMENT '設置為0無作用 這個動畫出現在施展者身上',\n  `gfxid2` int(10) NOT NULL DEFAULT '0' COMMENT '設置為0無作用 這個動畫出現在被攻擊者身上',\n  `gfxid3` int(10) NOT NULL DEFAULT '0' COMMENT '設置為0無作用 這個動畫由施展者往被攻擊者',\n  `gfxid4` int(10) NOT NULL DEFAULT '0' COMMENT '設置為0無作用 這個動畫由施展者周邊隨機座標出現指定次數',\n  `gfxid4_count` int(10) NOT NULL DEFAULT '0' COMMENT 'GFXID4 指定次數 設置0 GFXID4無作用',\n  `power` int(10) NOT NULL DEFAULT '0' COMMENT '受影響人的物屬性 1:力 2:敏 4:智 8:精 16:魅 32:體',\n  `srcdmg` int(10) NOT NULL DEFAULT '0' COMMENT '基礎攻擊質(隨機 設定10 隨機質產生1 ~ 10)',\n  `addsrcdmg` int(10) NOT NULL DEFAULT '0' COMMENT '是否加入武器產生的物理傷害質(1~100)',\n  `random1` int(10) NOT NULL DEFAULT '0' COMMENT '發動機率(1/1000)',\n  `random2` int(10) NOT NULL DEFAULT '0' COMMENT '受到強化質的機率影響(1/1000)',\n  `boss_holdout` tinyint(1) unsigned NOT NULL DEFAULT '0' COMMENT '設置為1該技能對spawnlist_boss召喚表內怪物不起作用',\n  `CounterMagic_Mode` int(1) NOT NULL DEFAULT '1' COMMENT '0=不消除魔法屏障1=魔法發動後才會消除魔法屏障2=只要攻擊就消除魔法屏障',\n  `note` varchar(150) DEFAULT '',\n  PRIMARY KEY (`id`),\n  KEY `id` (`id`)\n) ENGINE=MyISAM AUTO_INCREMENT=186 DEFAULT CHARSET=utf8;",
