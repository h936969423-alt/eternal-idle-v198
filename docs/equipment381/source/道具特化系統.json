  "schema": "CREATE TABLE `道具特化系統` (\n  `道具編號` int(10) NOT NULL,\n  `道具名稱` char(64) DEFAULT NULL,\n  `職業確認` int(1) NOT NULL DEFAULT '0' COMMENT '(0 = 不判斷、1 = 王族、2 = 騎士、3 = 法師、4 = 妖精、5 = 黑妖、6 = 龍騎士、7 = 幻術士) \t',\n  `需要的道具編號才能使用` int(10) NOT NULL DEFAULT '0',\n  `判定種族` int(2) NOT NULL DEFAULT '0' COMMENT '(0 = 不判斷、1 = 犬夜叉、2 = 鬼眼狂刀、3 = 星空) ',\n  `使用後是否刪除` int(1) NOT NULL DEFAULT '0' COMMENT '(0不刪 1刪除)  ',\n  `變身編號` int(10) NOT NULL DEFAULT '0',\n  `變身持續時間` int(10) NOT NULL DEFAULT '0',\n  `增加血` int(10) unsigned NOT NULL DEFAULT '0',\n  `增加魔` int(10) unsigned NOT NULL DEFAULT '0',\n  `增加力量` int(10) unsigned NOT NULL DEFAULT '0',\n  `增加敏捷` int(10) unsigned NOT NULL DEFAULT '0',\n  `增加智力` int(10) unsigned NOT NULL DEFAULT '0',\n  `增加體質` int(10) unsigned NOT NULL DEFAULT '0',\n  `增加精神` int(10) unsigned NOT NULL DEFAULT '0',\n  `增加魅力` int(10) unsigned NOT NULL DEFAULT '0',\n  `四屬性抗性` int(10) unsigned NOT NULL DEFAULT '0' COMMENT '地水火風屬性抗性',\n  `增加魔攻` int(10) unsigned NOT NULL DEFAULT '0' COMMENT '命中(遠距離和近距離)',\n  `命中` int(10) unsigned NOT NULL DEFAULT '0' COMMENT '命中(遠距離和近距離)',\n  `物理傷害` int(10) unsigned NOT NULL DEFAULT '0',\n  `減免物理傷害` int(10) unsigned NOT NULL DEFAULT '0',\n  `魔法傷害` int(10) unsigned NOT NULL DEFAULT '0',\n  `減免魔法傷害` int(10) unsigned NOT NULL DEFAULT '0',\n  `物理爆擊率` int(10) NOT NULL DEFAULT '0' COMMENT '(最高設定100%)',\n  `物理爆擊傷害` int(10) NOT NULL DEFAULT '0' COMMENT '(暗黑3的系統)',\n  `魔法爆擊率` int(10) NOT NULL DEFAULT '0' COMMENT '(最高設定100%)',\n  `魔法爆擊傷害` int(10) NOT NULL DEFAULT '0' COMMENT '(暗黑3的系統)',\n  `經驗獲取量` int(10) NOT NULL DEFAULT '0' COMMENT '(經驗加倍的意思)',\n  `道具時間` int(10) NOT NULL DEFAULT '0' COMMENT '若 IsEverlasting 不為0  , ItemTime 不能輸入值',\n  `是否為永久` int(2) NOT NULL DEFAULT '0' COMMENT '給予 1 = 是 0 = 否',\n  `技能編號` varchar(1000) DEFAULT NULL,\n  `技能時間` int(10) DEFAULT '0',\n  `永久給予經驗值` bigint(10) NOT NULL DEFAULT '0',\n  `永久給予正義值` int(5) NOT NULL DEFAULT '0',\n  `特效編號` int(10) NOT NULL DEFAULT '0',\n  PRIMARY KEY (`道具編號`)\n) ENGINE=MyISAM DEFAULT CHARSET=utf8;",
