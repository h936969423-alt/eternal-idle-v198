  "schema": "CREATE TABLE `weapon_skill` (\n  `weapon_id` int(11) unsigned NOT NULL AUTO_INCREMENT,\n  `note` varchar(255) DEFAULT NULL,\n  `probability` int(11) unsigned NOT NULL DEFAULT '0',\n  `fix_damage` int(11) unsigned NOT NULL DEFAULT '0',\n  `random_damage` int(11) unsigned NOT NULL DEFAULT '0',\n  `area` int(11) NOT NULL DEFAULT '0',\n  `skill_id` int(11) unsigned NOT NULL DEFAULT '0',\n  `skill_time` int(11) unsigned NOT NULL DEFAULT '0',\n  `effect_id` int(11) unsigned NOT NULL DEFAULT '0',\n  `effect_target` int(11) unsigned NOT NULL DEFAULT '0',\n  `arrow_type` int(11) unsigned NOT NULL DEFAULT '0',\n  `attr` int(11) unsigned NOT NULL DEFAULT '0',\n  `顯示特效` int(11) unsigned NOT NULL DEFAULT '0' COMMENT '特效編號',\n  `目標效果特效` int(11) unsigned NOT NULL DEFAULT '0' COMMENT '效果目標 1對方 0自已',\n  `顯示特效_2` int(11) unsigned NOT NULL DEFAULT '0' COMMENT '特效編號',\n  `目標效果特效_2` int(11) unsigned NOT NULL DEFAULT '0' COMMENT '效果目標 1對方 0自已',\n  `顯示特效_3` int(11) unsigned NOT NULL DEFAULT '0' COMMENT '特效編號',\n  `目標效果特效_3` int(11) unsigned NOT NULL DEFAULT '0' COMMENT '效果目標 1對方 0自已',\n  `顯示特效_4` int(11) unsigned NOT NULL DEFAULT '0' COMMENT '特效編號',\n  `目標效果特效_4` int(11) unsigned NOT NULL DEFAULT '0' COMMENT '效果目標 1對方 0自已',\n  `顯示特效_5` int(11) unsigned NOT NULL DEFAULT '0' COMMENT '特效編號',\n  `目標效果特效_5` int(11) unsigned NOT NULL DEFAULT '0' COMMENT '效果目標 1對方 0自已',\n  PRIMARY KEY (`weapon_id`)\n) ENGINE=MyISAM AUTO_INCREMENT=410341 DEFAULT CHARSET=utf8 COMMENT='MyISAM free: 10240 kB';",
