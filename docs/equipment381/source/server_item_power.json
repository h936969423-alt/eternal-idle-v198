  "schema": "CREATE TABLE `server_item_power` (\n  `id` int(10) NOT NULL AUTO_INCREMENT,\n  `note` varchar(100) DEFAULT NULL,\n  `ac` int(2) NOT NULL DEFAULT '0',\n  `hp` int(5) NOT NULL DEFAULT '0' COMMENT '血量',\n  `mp` int(5) NOT NULL DEFAULT '0' COMMENT '魔量',\n  `hpr` int(5) NOT NULL DEFAULT '0' COMMENT '回血量',\n  `mpr` int(5) NOT NULL DEFAULT '0' COMMENT '回魔量',\n  `mr` int(5) NOT NULL DEFAULT '0' COMMENT '魔防',\n  `sp` int(2) NOT NULL DEFAULT '0' COMMENT '魔攻',\n  `hit` int(2) NOT NULL DEFAULT '0' COMMENT '物理命中',\n  `dmgup` int(2) NOT NULL DEFAULT '0' COMMENT '物理攻擊',\n  `bowhit` int(2) NOT NULL DEFAULT '0' COMMENT '弓的命中',\n  `bowdmgup` int(2) NOT NULL DEFAULT '0' COMMENT '弓的攻擊',\n  `dice_dmg` int(2) NOT NULL DEFAULT '0' COMMENT '機率給予爆擊 ',\n  `dmg` int(2) NOT NULL DEFAULT '0' COMMENT '機率給予爆擊質',\n  `er` int(2) NOT NULL DEFAULT '0' COMMENT '迴避率',\n  `dodge` int(2) NOT NULL DEFAULT '0' COMMENT '閃避率',\n  `dice_hp` int(2) NOT NULL DEFAULT '0' COMMENT '機率-吸血',\n  `sucking_hp` int(2) NOT NULL DEFAULT '0' COMMENT '機率-吸血質',\n  `dice_mp` int(2) NOT NULL DEFAULT '0' COMMENT '機率-吸魔',\n  `sucking_mp` int(2) NOT NULL DEFAULT '0' COMMENT '機率-吸魔質',\n  `double_dmg` int(2) NOT NULL DEFAULT '0' COMMENT '機率發動加倍的攻擊力',\n  `lift` int(2) NOT NULL DEFAULT '0' COMMENT '機率可以將對方的武防裝備解除',\n  `defense_water` int(2) NOT NULL DEFAULT '0',\n  `defense_wind` int(2) NOT NULL DEFAULT '0',\n  `defense_fire` int(2) NOT NULL DEFAULT '0',\n  `defense_earth` int(2) NOT NULL DEFAULT '0',\n  `regist_stun` int(2) NOT NULL DEFAULT '0',\n  `regist_stone` int(2) NOT NULL DEFAULT '0',\n  `regist_sleep` int(2) NOT NULL DEFAULT '0',\n  `regist_freeze` int(2) NOT NULL DEFAULT '0',\n  `regist_sustain` int(2) NOT NULL DEFAULT '0',\n  `regist_blind` int(2) NOT NULL DEFAULT '0',\n  `gfx` varchar(45) DEFAULT NULL,\n  `msg` varchar(50) DEFAULT NULL COMMENT '完成套裝要出現的文字',\n  PRIMARY KEY (`id`),\n  KEY `id` (`id`)\n) ENGINE=MyISAM AUTO_INCREMENT=6614 DEFAULT CHARSET=utf8;",
