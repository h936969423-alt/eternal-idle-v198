  "schema": "CREATE TABLE `強化武器加成系統` (\n  `序號` int(20) NOT NULL AUTO_INCREMENT,\n  `武器編號` int(20) NOT NULL DEFAULT '0',\n  `說明` varchar(255) DEFAULT NULL,\n  `強化值` int(20) NOT NULL DEFAULT '0',\n  `機率` int(20) NOT NULL DEFAULT '0',\n  `物理命中提升` int(20) NOT NULL DEFAULT '0',\n  `物理傷害提升` int(20) NOT NULL DEFAULT '0',\n  `魔法傷害提升` int(20) NOT NULL DEFAULT '0',\n  `攻擊暴擊傷害倍率` double(20,1) NOT NULL DEFAULT '1.0',\n  `攻擊暴擊發動機率` int(20) NOT NULL DEFAULT '0',\n  `攻擊暴擊發動特效` int(20) NOT NULL DEFAULT '0',\n  `血量提升` int(20) NOT NULL DEFAULT '0',\n  `魔力提升` int(20) NOT NULL DEFAULT '0',\n  `經驗值提升` int(20) NOT NULL DEFAULT '0',\n  `自動施放技能` int(20) NOT NULL DEFAULT '0',\n  `施放特效` int(20) NOT NULL DEFAULT '0',\n  `定時特效` int(20) NOT NULL DEFAULT '0',\n  `是否破聖潔` tinyint(1) NOT NULL,\n  `破聖潔幾率` int(10) NOT NULL,\n  `破除聖潔特效` int(10) NOT NULL,\n  PRIMARY KEY (`序號`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8;",
